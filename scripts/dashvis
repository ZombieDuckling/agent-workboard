#!/bin/bash
# dashvis: refresh every machine, open the web board, print a short summary.
# On the board host it starts the web server if needed; on another machine (WB_BOARD_HOST set)
# it opens an SSH tunnel to the board host first.
# Usage: dashvis [--no-open]
set -uo pipefail

CONFIG="${WB_CONFIG:-$HOME/.config/workboard/config.env}"
# shellcheck disable=SC1090
[ -f "$CONFIG" ] && source "$CONFIG"
PORT="${WB_PORT:-4747}"
URL="http://127.0.0.1:$PORT/"
HERE="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
OPEN=1
[ "${1:-}" = "--no-open" ] && OPEN=0

up() { curl -s -o /dev/null -m 3 "$URL"; }
open_url() {
  if command -v open >/dev/null 2>&1; then open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1
  fi
}

if [ -z "${WB_BOARD_HOST:-}" ]; then
  WB=(python3 "$HERE/workboard.py")
  if ! up; then
    if [ "$(uname)" = Darwin ] && launchctl print "gui/$(id -u)/dev.workboard.web" >/dev/null 2>&1; then
      launchctl kickstart -k "gui/$(id -u)/dev.workboard.web" >/dev/null 2>&1
    else
      nohup python3 "$HERE/serve.py" >>"${WB_DATA_DIR:-$HERE/..}/web.log" 2>&1 &
    fi
    for _ in 1 2 3 4 5; do up && break; sleep 1; done
  fi
else
  WB=("$HERE/workboard-remote")
  if ! up; then
    ssh -fN -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
      -L "$PORT:127.0.0.1:$PORT" "$WB_BOARD_HOST" 2>/dev/null
    for _ in 1 2 3 4 5; do up && break; sleep 1; done
  fi
fi

if up; then
  echo "Board: $URL"
  [ "$OPEN" = 1 ] && open_url "$URL"
else
  echo "Board: NOT REACHABLE at $URL (board host asleep or web server down)"
fi

echo "Sync: $("${WB[@]}" sync 2>&1 | tr '\n' ' ')"
echo
"${WB[@]}" summary
